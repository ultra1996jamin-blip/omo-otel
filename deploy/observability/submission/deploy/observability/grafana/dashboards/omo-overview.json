{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "jaeger", "name": "Jaeger", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "oh-my-openagent OTEL tracing overview — agent calls, tool executions, MCP calls, hook timing",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "Trace Explorer",
      "url": "/d/omo-otel-traces",
      "type": "link",
      "icon": "external link icon",
      "tooltip": "Open the Traces dashboard (Jaeger trace waterfall view)",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Agent Executions",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list" } },
      "title": "Agent call rate (req/min)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (gen_ai_agent_name) (rate(omo_duration_milliseconds_count{span_name=~\".*gen_ai\\\\.completion\\\\..*\"}[1m])) * 60",
          "legendFormat": "{{ gen_ai_agent_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "title": "Agent p99 latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (gen_ai_agent_name, le) (rate(omo_duration_milliseconds_bucket{span_name=~\".*gen_ai\\\\.completion\\\\..*\"}[5m])))",
          "legendFormat": "{{ gen_ai_agent_name }} p99",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Hook Executions",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 11,
      "title": "Hook call rate (req/min)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (hook_name) (rate(omo_duration_milliseconds_count{hook_name!=\"\"}[1m])) * 60",
          "legendFormat": "{{ hook_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 12,
      "title": "Hook error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (hook_name) (rate(omo_duration_milliseconds_count{hook_name!=\"\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (hook_name) (rate(omo_duration_milliseconds_count{hook_name!=\"\"}[5m]))",
          "legendFormat": "{{ hook_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "MCP Calls",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 21,
      "title": "MCP call rate (req/min)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(omo_duration_milliseconds_count{mcp_server_name!=\"\"}[1m]) * 60",
          "legendFormat": "{{ mcp_server_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 22,
      "title": "MCP p50 / p99 latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(omo_duration_milliseconds_bucket{mcp_server_name!=\"\"}[5m]))",
          "legendFormat": "{{ mcp_server_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(omo_duration_milliseconds_bucket{mcp_server_name!=\"\"}[5m]))",
          "legendFormat": "{{ mcp_server_name }} p99",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "title": "Hook Timing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "id": 31,
      "title": "Hook p95 latency (ms) — top consumers",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (hook_name, le) (rate(omo_duration_milliseconds_bucket{hook_name!=\"\"}[5m]))))",
          "legendFormat": "{{ hook_name }}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["oh-my-openagent", "otel"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "oh-my-openagent OTEL Overview",
  "uid": "omo-otel-overview",
  "version": 1
}
