{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "oh-my-openagent span duration breakdown (agent/hook/MCP). For the full call tree, use Jaeger or OpenLIT directly — Jaeger's in-memory storage doesn't reliably serve time-bounded search here.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "OTEL Overview",
      "url": "/d/omo-otel-overview",
      "type": "link",
      "icon": "external link icon",
      "tooltip": "Go to metrics overview dashboard",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Quick Stats",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Agent Executions (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(omo_duration_milliseconds_count{span_name=~\"agent\\\\.execute\\\\..*\"}[1h])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Hook Executions (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(omo_duration_milliseconds_count{hook_name!=\"\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "MCP Calls (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(omo_duration_milliseconds_count{mcp_server_name!=\"\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "LLM Turns (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(omo_duration_milliseconds_count{span_name=~\".*gen_ai\\\\.completion\\\\..*\"}[1h])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 30,
      "title": "Span Duration Breakdown",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 31,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Agent execution p50/p99 duration (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(omo_duration_milliseconds_bucket{span_name=~\"agent\\\\.execute\\\\..*\"}[5m]))",
          "legendFormat": "{{ span_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(omo_duration_milliseconds_bucket{span_name=~\"agent\\\\.execute\\\\..*\"}[5m]))",
          "legendFormat": "{{ span_name }} p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 32,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Hook execution p50/p99 duration (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (hook_name, le) (rate(omo_duration_milliseconds_bucket{hook_name!=\"\"}[5m])))",
          "legendFormat": "{{ hook_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (hook_name, le) (rate(omo_duration_milliseconds_bucket{hook_name!=\"\"}[5m])))",
          "legendFormat": "{{ hook_name }} p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 33,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "MCP call p50/p99 duration by server (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (mcp_server_name, le) (rate(omo_duration_milliseconds_bucket{mcp_server_name!=\"\"}[5m])))",
          "legendFormat": "{{ mcp_server_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (mcp_server_name, le) (rate(omo_duration_milliseconds_bucket{mcp_server_name!=\"\"}[5m])))",
          "legendFormat": "{{ mcp_server_name }} p99",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["oh-my-openagent", "otel", "traces", "jaeger"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "oh-my-openagent — Traces",
  "uid": "omo-otel-traces",
  "version": 1
}
