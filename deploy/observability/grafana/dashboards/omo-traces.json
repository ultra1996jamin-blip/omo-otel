      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "MCP Calls (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(omo_duration_milliseconds_count{mcp_server_name!=\"\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "LLM Turns (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(omo_duration_milliseconds_count{span_name=~\".*gen_ai\\\\.completion\\\\..*\"}[1h])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "Trace Explorer — full call tree (agent → tool → MCP → LLM)",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "PC9A941E8F2E49454" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 6 },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "Recent Traces — oh-my-openagent (click a trace ID to see full call tree)",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "PC9A941E8F2E49454" },
          "queryType": "search",
          "service": "oh-my-openagent",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 20,
      "title": "Agent Execution Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "PC9A941E8F2E49454" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 27 },
      "id": 21,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "Agent Execution Spans (agent.execute.*) — each row is one subagent call",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "PC9A941E8F2E49454" },
          "queryType": "search",
          "service": "oh-my-openagent",
          "operation": "agent.execute.sisyphus",
          "limit": 10,
          "refId": "A"
        },
        {
          "datasource": { "type": "jaeger", "uid": "PC9A941E8F2E49454" },
          "queryType": "search",
          "service": "oh-my-openagent",
          "operation": "agent.execute.atlas",
          "limit": 10,
          "refId": "B"
        },
        {
          "datasource": { "type": "jaeger", "uid": "PC9A941E8F2E49454" },
          "queryType": "search",
          "service": "oh-my-openagent",
          "operation": "agent.execute.oracle",
          "limit": 10,
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 30,
      "title": "Span Duration Breakdown",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "id": 31,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Agent execution p50/p99 duration (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(omo_duration_milliseconds_bucket{span_name=~\"agent\\\\.execute\\\\..*\"}[5m]))",
          "legendFormat": "{{ span_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(omo_duration_milliseconds_bucket{span_name=~\"agent\\\\.execute\\\\..*\"}[5m]))",
          "legendFormat": "{{ span_name }} p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "id": 32,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Hook execution p50/p99 duration (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (hook_name, le) (rate(omo_duration_milliseconds_bucket{hook_name!=\"\"}[5m])))",
          "legendFormat": "{{ hook_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (hook_name, le) (rate(omo_duration_milliseconds_bucket{hook_name!=\"\"}[5m])))",
          "legendFormat": "{{ hook_name }} p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "id": 33,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "MCP call p50/p99 duration by server (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (mcp_server_name, le) (rate(omo_duration_milliseconds_bucket{mcp_server_name!=\"\"}[5m])))",
          "legendFormat": "{{ mcp_server_name }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (mcp_server_name, le) (rate(omo_duration_milliseconds_bucket{mcp_server_name!=\"\"}[5m])))",
          "legendFormat": "{{ mcp_server_name }} p99",
          "refId": "B"
        }
      ]
    }
