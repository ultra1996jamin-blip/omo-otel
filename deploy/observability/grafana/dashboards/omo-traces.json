  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Quick Stats",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Agent Executions (last 1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(omo_duration_milliseconds_count{span_name=~\"agent\\\\.execute\\\\..*\"}[1h])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-by-claude" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
