    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "content": "## A/B 회귀 분석 사용 방법\n\n1. 왼쪽 변수 패널에서 **시나리오 A 시간 범위**와 **시나리오 B 시간 범위**를 선택하세요.\n2. 아래 비교 패널이 두 시간대의 지표를 나란히 보여줍니다.\n3. 배포 이벤트(빨간 주석)를 기준으로 Before = A, After = B로 설정하면 회귀 검증이 됩니다.\n4. **에러율↑ / 레이턴시↑ / 토큰↑** 가 모두 없으면 회귀 없음으로 판단할 수 있습니다.",
        "mode": "markdown"
      },
      "title": "사용 방법",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-by-claude"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-by-claude"
          },
          "expr": "histogram_quantile(0.50, sum(rate(omo_duration_milliseconds_bucket{span_name=~\"$span_filter\", gen_ai_request_model=~\"$model_filter\", gen_ai_agent_name=~\"$agent_filter\"}[$__rate_interval])) by (le))",
          "legendFormat": "[A] p50",
          "refId": "A1"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-by-claude"
          },
          "expr": "histogram_quantile(0.95, sum(rate(omo_duration_milliseconds_bucket{span_name=~\"$span_filter\", gen_ai_request_model=~\"$model_filter\", gen_ai_agent_name=~\"$agent_filter\"}[$__rate_interval])) by (le))",
          "legendFormat": "[A] p95",
          "refId": "A2"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-by-claude"
          },
